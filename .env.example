# Токен от @BotFather
BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# Секрет, который Telegram будет присылать в заголовке X-Telegram-Bot-Api-Secret-Token.
# Только A-Z, a-z, 0-9, _ и -. Придумайте случайную строку.
WEBHOOK_SECRET=change_me_random_string

# Пароль для служебного эндпоинта /api/setup (установка/удаление webhook).
SETUP_SECRET=change_me_another_random_string
